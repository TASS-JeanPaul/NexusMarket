{
  "info": {
    "name": "NexusMarket API",
    "description": "Recorrido completo del API en orden. Cada peticion guarda los identificadores que la siguiente necesita, asi que basta con ejecutar la coleccion de arriba hacia abajo. Los documentos, correos y codigos llevan un sufijo de tiempo, de modo que la coleccion se puede volver a correr sin reiniciar la base de datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "adminId", "value": "" },
    { "key": "supervisorId", "value": "" },
    { "key": "operatorId", "value": "" },
    { "key": "sellerId", "value": "" },
    { "key": "buyerId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "physicalProductId", "value": "" },
    { "key": "digitalProductId", "value": "" },
    { "key": "variantId", "value": "" },
    { "key": "warehouseId", "value": "" },
    { "key": "inventoryId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderDetailId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "shipmentId", "value": "" },
    { "key": "returnId", "value": "" },
    { "key": "secondReturnId", "value": "" },
    { "key": "refundId", "value": "" }
  ],
  "item": [
    {
      "name": "Salud del API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El API responde', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('La base de datos responde', () => pm.expect(d.database).to.eql('UP'));",
              "if (pm.response.code !== 200) {",
              "  console.log('Si la base esta caida: docker compose up -d');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "Primera peticion a ejecutar. Devuelve 200 si el API y la base responden, y 503 si el API esta arriba pero no alcanza PostgreSQL."
      }
    },
