{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "NexusMarket API",
      "request": "launch",
      "mainClass": "application.NexusMarketApplication",
      "projectName": "nexusmarket",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "SPRING_APPLICATION_NAME": "nexusmarket"
      }
    },
    {
      "type": "java",
      "name": "NexusMarket API (attach on 5005)",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005
    }
  ]
}
